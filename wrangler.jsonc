{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "57c86849-98e0-48b4-a835-f60427695c65","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "0f647497037340eb9876d67f9714414c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
